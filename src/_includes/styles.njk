<style>
  :root {
    color-scheme: light;
    --ink: #0e1620;
    --ink-soft: #364152;
    --muted: #6a7585;
    --line: #e3e8ef;
    --line-soft: #eef2f7;
    --bg: #fafbfc;
    --panel: #ffffff;
    --accent: #08768b;
    --accent-strong: #0a7188;
    --accent-soft: #e6f4f7;
    --good: #087348;
    --warn: #8a5700;
    --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.04), 0 1px 3px rgba(15, 23, 42, 0.06);
    --shadow-md: 0 6px 16px rgba(15, 23, 42, 0.08), 0 2px 4px rgba(15, 23, 42, 0.04);
    --shadow-lg: 0 24px 50px rgba(15, 23, 42, 0.18);
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  main { flex: 1 0 auto; }
  footer { flex-shrink: 0; }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  code, pre { font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.9em; }
  pre { background: var(--line-soft); border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; overflow-x: auto; }
  code { background: var(--line-soft); padding: 1px 6px; border-radius: 5px; }
  pre code { background: none; padding: 0; }

  .wrap {
    width: min(720px, calc(100% - 40px));
    margin: 0 auto;
  }
  .wrap-wide {
    width: min(1120px, calc(100% - 40px));
    margin: 0 auto;
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(250, 251, 252, 0.85);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    width: min(1120px, calc(100% - 40px));
    margin: 0 auto;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 16px;
    color: var(--ink);
    text-decoration: none;
  }
  .brand:hover { text-decoration: none; }
  .mark {
    width: 28px;
    height: 28px;
    display: block;
    border-radius: 7px;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.12);
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
    font-size: 14px;
    color: var(--ink-soft);
  }
  .nav-links a { color: inherit; text-decoration: none; }
  .nav-links a:hover { color: var(--ink); }
  .nav .button {
    padding: 8px 14px;
    min-height: 36px;
    font-size: 14px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    border-radius: 8px;
    font-weight: 600;
    line-height: 1;
  }
  .nav .button.secondary { background: #fff; color: var(--ink); border: 1px solid var(--line); }
  .nav .button.secondary:hover { border-color: #c8d0db; }
  .nav .button.accent { background: var(--accent); color: #fff; border-color: var(--accent); }
  .nav .button.accent:hover { background: var(--accent-strong); }

  main {
    padding: 48px 0 80px;
  }
  h1 {
    font-size: 32px;
    font-weight: 800;
    letter-spacing: -0.01em;
    margin: 0 0 8px;
  }
  .subtitle {
    color: var(--muted);
    font-size: 14px;
    margin: 0 0 32px;
  }
  h2 {
    font-size: 20px;
    font-weight: 700;
    margin: 32px 0 12px;
    scroll-margin-top: 80px;
  }
  h3 {
    font-size: 17px;
    font-weight: 700;
    margin: 24px 0 10px;
    scroll-margin-top: 80px;
  }
  p {
    margin: 0 0 14px;
    color: var(--ink-soft);
  }
  ul, ol {
    margin: 0 0 14px;
    padding-left: 20px;
    color: var(--ink-soft);
  }
  li { margin-bottom: 6px; }
  blockquote {
    margin: 18px 0;
    padding: 12px 18px;
    border-left: 3px solid var(--accent);
    background: var(--accent-soft);
    color: var(--ink-soft);
    border-radius: 0 8px 8px 0;
  }
  blockquote p:last-child { margin-bottom: 0; }
  hr {
    border: none;
    border-top: 1px solid var(--line);
    margin: 32px 0;
  }

  /* Scrollable wrapper injected by the Eleventy wrapTables transform. */
  .table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: 0 0 20px;
    border: 1px solid var(--line);
    border-radius: 10px;
  }
  .table-wrap table { margin: 0; border: none; border-radius: 0; }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14.5px;
    margin: 0 0 20px;
  }
  thead tr {
    background: var(--line-soft);
    border-bottom: 2px solid var(--line);
  }
  th {
    text-align: left;
    padding: 9px 14px;
    font-weight: 600;
    color: var(--ink);
  }
  td {
    padding: 9px 14px;
    border-bottom: 1px solid var(--line);
    color: var(--ink-soft);
    vertical-align: top;
  }
  tr:last-child td { border-bottom: none; }
  tbody tr:hover { background: var(--line-soft); }

  /* Images in post body: markdown renders bare <img> not <figure>, so scope
     the size constraint and chrome here rather than relying on figure img. */
  .post-body img {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: 10px;
    border: 1px solid var(--line);
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);
    margin: 20px auto;
  }

  figure { margin: 20px 0; }
  figure img {
    display: block;
    max-width: 100%;
    border-radius: 10px;
    border: 1px solid var(--line);
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);
  }
  figcaption {
    margin-top: 8px;
    font-size: 13.5px;
    color: var(--muted);
  }

  .note {
    padding: 16px 20px;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--panel);
    color: var(--ink-soft);
    font-size: 14.5px;
    margin-bottom: 14px;
  }
  .note strong { color: var(--ink); }

  .pro-badge {
    display: inline-block;
    padding: 1px 6px;
    border-radius: 4px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 12px;
    font-weight: 600;
    vertical-align: middle;
    margin-left: 4px;
  }

  .faq-section {
    margin-top: 40px;
  }
  .faq-section h2 {
    margin-bottom: 16px;
  }
  .faq-item {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--panel);
    margin-bottom: 8px;
    overflow: hidden;
  }
  .faq-item > summary {
    list-style: none;
    cursor: pointer;
    padding: 14px 18px;
    font-weight: 600;
    color: var(--ink);
    position: relative;
    padding-right: 44px;
  }
  .faq-item > summary::-webkit-details-marker { display: none; }
  .faq-item > summary::after {
    content: "+";
    position: absolute;
    right: 18px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 18px;
    color: var(--muted);
    transition: transform 0.15s ease;
  }
  .faq-item[open] > summary::after {
    content: "−";
  }
  .faq-item > summary:hover {
    background: var(--line-soft);
  }
  .faq-answer {
    padding: 0 18px 14px;
    color: var(--ink-soft);
  }
  .faq-answer > :last-child { margin-bottom: 0; }

  footer {
    padding: 32px 0;
    background: #0c1219;
    color: rgba(255, 255, 255, 0.55);
    font-size: 13.5px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  footer .wrap-wide {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  footer a { color: rgba(255, 255, 255, 0.85); }
  footer a:hover { color: #fff; }
  footer .footer-links { display: flex; flex-wrap: wrap; gap: 6px 14px; }
  footer .footer-links .sep { color: rgba(255, 255, 255, 0.3); }

  .mobile-nav { display: none; }
  .mobile-menu summary { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; padding: 0 12px; border: 1px solid #bac5cf; border-radius: 8px; background: white; color: var(--ink); cursor: pointer; font-size: 14px; font-weight: 600; list-style: none; }
  .mobile-menu summary::-webkit-details-marker { display: none; }
  .mobile-menu[open] summary { background: #eaf3f5; border-color: #08768b; }
  .mobile-nav-panel { position: absolute; top: 100%; left: 0; right: 0; padding: 12px 20px 20px; background: #fafbfc; border-bottom: 1px solid var(--line); box-shadow: 0 12px 20px #0c12191a; max-height: calc(100dvh - 64px); overflow-y: auto; overscroll-behavior: contain; }
  .mobile-nav-panel a { display: flex; align-items: center; min-height: 48px; padding: 10px 14px; border-radius: 7px; color: var(--ink); font-size: 16px; text-decoration: none; }
  .mobile-nav-panel a:hover { background: #edf2f5; }
  .mobile-nav-panel a[aria-current="page"] { background: #e3f0f3; color: #075d6e; font-weight: 700; border-left: 3px solid #08768b; }
  .nav :is(a,summary):focus-visible { outline: 3px solid #08768b; outline-offset: 3px; }
  @media (max-width: 720px) {
    .mobile-nav { display: flex; align-items: center; gap: 10px; }
    .nav-inner { gap: 10px; }
    .mobile-nav .button.accent { min-height: 44px; background: #08768b; }

    .nav .desktop-nav { display: none; }
    .nav-links { gap: 12px; }
    .nav .button { padding: 8px 12px; font-size: 13px; }
    h1 { font-size: 28px; }
    h2 { font-size: 20px; }
    footer .wrap-wide { flex-direction: column; align-items: flex-start; }
  }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  footer .wrap-wide > span:first-child a, .price-note a, .pricing-note a, .pricing a, .answer a { text-decoration: underline; text-underline-offset: 3px; }
  :is(a,button,summary):focus-visible { outline: 3px solid #08768b; outline-offset: 4px; }
  @media(prefers-reduced-motion:reduce) { html { scroll-behavior: auto; } }
</style>
