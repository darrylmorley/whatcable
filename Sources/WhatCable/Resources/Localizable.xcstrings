    "%lld USB-C ports detected, but nothing is currently plugged in. Turn off \"Hide empty ports\" in Settings to see them." : {
      "localizations" : {
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Հայտնաբերվել է %lld USB-C պորտ, սակայն այս պահին ոչինչ միացված չէ։ Դրանք տեսնելու համար «Կարգավորումներում» անջատեք «Թաքցնել դատարկ պորտերը» ֆունկցիան:"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检测到 %lld 个 USB-C 端���，但当前没有接入设备。可在\"设置\"中关闭\"隐藏空端口\"查看它们。"
          }
        }
      }
    },
