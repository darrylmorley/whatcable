"macOS reports your %@'s current mode as %@, which would need more bandwidth than this link carries uncompressed. High-resolution displays use compression (DSC) to fit a mode like this through a link like this. The picture is reaching the display, so this is working as intended." = "macOS meldt dat de huidige modus van uw %@ %@ is, wat ongecomprimeerd meer bandbreedte zou vereisen dan deze verbinding kan dragen. Hoge-resolutieschermen gebruiken compressie (DSC) om zo'n modus door zo'n verbinding te laten passen. Het beeld bereikt het scherm, dus dit werkt zoals bedoeld.";

/* Issue #393: CIO is a floor on cable capability, not a cap (negotiated-rate resolution). Translated; nuance is community-refinable. */
"Controller confirms Thunderbolt cable (%@)" = "Controller bevestigt Thunderbolt-kabel (%@)";
"Thunderbolt link active at %@" = "Thunderbolt-verbinding actief op %@";
"The cable claims %@, and the link has run at least %@. There's no host or device data to compare against, so we can't tell if anything else is limiting it." = "De kabel claimt %1$@, en de verbinding heeft ten minste %2$@ gedraaid. Er zijn geen gegevens over de poort of het apparaat om mee te vergelijken, dus we kunnen niet zeggen of iets anders de beperkende factor is.";

"Shared controller port" = "Gedeelde controllerpoort";

/* USB-IF certification (DAR-215) */
"USB-IF certified. Manufacturer: %@, model %@ (%@)" = "USB-IF-gecertificeerd. Fabrikant: %1$@, model %2$@ (%3$@)";
"USB-IF certified. Manufacturer: %@, model %@" = "USB-IF-gecertificeerd. Fabrikant: %1$@, model %2$@";
"USB-IF certified. Manufacturer: %@ (%@)" = "USB-IF-gecertificeerd. Fabrikant: %1$@ (%2$@)";
"USB-IF certified. Manufacturer: %@" = "USB-IF-gecertificeerd. Fabrikant: %1$@";
"The cable's declared maker matches the USB-IF certificate" = "De opgegeven fabrikant van de kabel komt overeen met het USB-IF-certificaat";

/* Header for a USB controller group in the connected-devices tree. */
"USB bus" = "USB-bus";
"USB device, data blocked" = "USB-apparaat, data geblokkeerd";
"macOS is holding data back until you approve the accessory." = "macOS houdt data tegen totdat je het accessoire goedkeurt.";
"Video is working. macOS is holding data back until you approve the accessory." = "Beeld werkt. macOS houdt data tegen totdat je het accessoire goedkeurt.";
"USB device, data blocked · %lldW charger" = "USB-apparaat, data geblokkeerd · %lldW oplader";
/* Port card source attribution (grouped headers + e-marker read state) */
"Present, but not read on this connection. Try reconnecting; some chargers and docks block the read." = "Aanwezig, maar niet gelezen op deze verbinding. Probeer de kabel opnieuw aan te sluiten; sommige opladers en docks blokkeren het lezen.";
"Present, but not read on this connection. macOS usually reads it above 3A or over Thunderbolt." = "Aanwezig, maar niet gelezen op deze verbinding. macOS leest hem meestal alleen boven 3 A of via Thunderbolt.";
"This port can't read cable details: USB-only, no Power Delivery." = "Deze poort kan geen kabelgegevens lezen: alleen USB, geen Power Delivery.";
"The %@ contract shows the charger treated this as an e-marked, 5A-capable cable, so charging isn't limited by the cable. This Mac couldn't get its own read here. Connect the cable to another device to see its details." = "Het %@-contract laat zien dat de oplader deze kabel behandelde als een e-marker-kabel met een capaciteit van 5 A, dus het opladen wordt niet beperkt door de kabel. Deze Mac kon hem hier niet zelf uitlezen. Sluit de kabel aan op een ander apparaat om de gegevens te zien.";
"No e-marker response. Cable details aren't available on this connection. Try another device to read it." = "Geen reactie van de e-marker. Kabelgegevens zijn niet beschikbaar op deze verbinding. Probeer een ander apparaat om hem te lezen.";
"Reading cable details…" = "Kabelgegevens worden gelezen…";
"No e-marker read. The cable may have one; macOS usually reads it above 3A or over Thunderbolt." = "Geen e-marker gelezen. De kabel heeft er mogelijk een; macOS leest hem meestal alleen boven 3 A of via Thunderbolt.";
"Passive (no signal-conditioning electronics)" = "Passief (geen signaalconditionerende elektronica)";
"%@ isn't in our bundled vendor list" = "%1$@ staat niet in onze meegeleverde fabrikantenlijst";
"%@ isn't in our copy of the USB-IF registry" = "%1$@ staat niet in onze kopie van het USB-IF-register";
"What your Mac measured" = "Wat je Mac heeft gemeten";
"What the cable's e-marker reports" = "Wat de e-marker van de kabel meldt";
"What the charger reports" = "Wat de oplader meldt";
"What WhatCable knows" = "Wat WhatCable weet";
"Made by %@ (%@), per our bundled vendor list" = "Gemaakt door %1$@ (%2$@), volgens onze meegeleverde fabrikantenlijst";
"Answered, but reported no capability data." = "Heeft geantwoord, maar geen capaciteitsgegevens gemeld.";
"Certification ID" = "Certificerings-ID";
"Connect a charger to identify the cable." = "Sluit een oplader aan om de kabel te identificeren.";

/* Power Monitor: a charge path that never negotiates a contract (issue #592) */
"No PD contract on this port. Incoming power shows in System Power Input below." = "Geen PD-contract op deze poort. Inkomend vermogen wordt weergegeven in Systeemvermogensinvoer hieronder.";

/* PD event log: opcode-plus-argument decode of PortControllerEvtBuffer */
"Plug attached" = "Stekker aangesloten";
"Plug detached" = "Stekker losgekoppeld";
"Plug event" = "Stekkergebeurtenis";
"Source capabilities received (%lld PDOs)" = "Bronmogelijkheden ontvangen (%lld PDO's)";
"Request sent" = "Verzoek verzonden";
"Source ready" = "Bron gereed";
"Source ready rejected" = "Bron gereed geweigerd";
"Partner identity received" = "Identiteit van apparaat ontvangen";
"Mac became power source" = "Mac werd stroombron";
"The Mac asked the source for one of the power levels it had offered." = "De Mac vroeg de bron om een van de aangeboden vermogensniveaus.";
"The source reported whether the requested power level is now in place." = "De bron meldde of het gevraagde vermogensniveau nu actief is.";
"The Mac started supplying power to the device on this port." = "De Mac begon het apparaat op deze poort van stroom te voorzien.";
"This event code has not been decoded yet." = "Deze gebeurteniscode is nog niet ontcijferd.";
"The port's attach and detach counters move with this event, so it lines up with what Port Health shows." = "De tellers voor aansluiten en loskoppelen van de poort bewegen mee met deze gebeurtenis, dus die komt overeen met wat Poortgezondheid laat zien.";
"The source sent its list of power data objects. The argument byte is how many it offered." = "De bron stuurde zijn lijst met Power Data Objects. De argumentbyte geeft aan hoeveel er zijn aangeboden.";
"The Mac sent a request picking one of the advertised power levels. It always follows a source capabilities event." = "De Mac stuurde een verzoek en koos een van de aangeboden vermogensniveaus. Het volgt altijd op een gebeurtenis met bronmogelijkheden.";
"The outcome of the request. An argument of 0x81 means the source turned it down and the old power level stayed." = "De uitkomst van het verzoek. Argument 0x81 betekent dat de bron het afwees en het oude vermogensniveau bleef staan.";
"The Mac switched to supplying power on this port, for example when it charges an attached device." = "De Mac ging op deze poort stroom leveren, bijvoorbeeld wanneer hij een aangesloten apparaat oplaadt.";
"This code turns up in the buffer but we have not yet matched it to a behaviour." = "Deze code komt voor in de buffer, maar we hebben er nog geen gedrag aan gekoppeld.";
"Argument %@" = "Argumentbyte %@";
"Arguments %@" = "Argumentbytes %@";
"Source ready (result unknown)" = "Bron gereed (uitkomst onbekend)";
