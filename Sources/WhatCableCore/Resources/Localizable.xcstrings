    "Legitimate USB-IF members ship cables with a non-zero vendor ID. A zeroed VID is a common counterfeit signature.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I membri legittimi di USB-IF spediscono cavi con un ID fornitore diverso da zero. Un VID a zero è una comune firma contraffatta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正规的 USB-IF 成员通常在线缆中使用非零 vendor ID。全零 VID 是常见的仿冒特征。"
          }
        }
      }
    },
    "Linked at %@": {
      "localizations": {
