<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>via %lld hubs</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>przez %lld koncentratory</string>
			<key>many</key>
			<string>przez %lld koncentratorów</string>
			<key>one</key>
			<string>przez %lld koncentrator</string>
			<key>other</key>
			<string>przez %lld koncentratora</string>
		</dict>
	</dict>
	<key>%lld USB devices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld urządzenia USB</string>
			<key>many</key>
			<string>%lld urządzeń USB</string>
			<key>one</key>
			<string>%lld urządzenie USB</string>
			<key>other</key>
			<string>%lld urządzenia USB</string>
		</dict>
	</dict>
	<key>Show %lld hubs</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Pokaż %lld koncentratory</string>
			<key>many</key>
			<string>Pokaż %lld koncentratorów</string>
			<key>one</key>
			<string>Pokaż %lld koncentrator</string>
			<key>other</key>
			<string>Pokaż %lld koncentratora</string>
		</dict>
	</dict>
</dict>
</plist>
